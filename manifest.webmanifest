{
  "name": "Movie & Show Tracker",
  "short_name": "Movie & Show",
  "description": "Track movies and shows you want to watch, are watching, and have watched.",
  "id": "./",
  "start_url": "./#/home",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#f8f9fb",
  "theme_color": "#1d6b58",
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icons/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    }
  ],
  "shortcuts": [
    {
      "name": "Alerts",
      "url": "./#/alerts"
    },
    {
      "name": "Library",
      "url": "./#/library"
    },
    {
      "name": "Discover",
      "url": "./#/discover"
    }
  ]
}